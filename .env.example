# ── AI Provider (OpenAI-compatible) ──
# Supports OpenAI, Anthropic (via API proxy), Ollama, vLLM, LM Studio, or any OpenAI-compatible endpoint
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Web Search (SearXNG) ──
# Base URL of your SearXNG instance (self-hosted or public)
# Example self-hosted: http://localhost:4000
# Example public: https://searx.be
SEARXNG_BASE_URL=http://localhost:4000

# ── Optional: Currency for pricing (default: USD) ──
# Supported: USD, EUR, GBP, PLN, CAD, AUD
CURRENCY=USD
